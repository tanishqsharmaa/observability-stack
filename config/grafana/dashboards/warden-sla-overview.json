      "id": 1,
      "title": "p50/p95/p99 Query Latency (SLO: p50<1.5s, p95<3.0s, p99<4.5s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(warden_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(warden_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 (Tail)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(warden_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 (Peak Spike)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Cache Hit Ratio (L1 / L2 / Live Retrieval)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(warden_cache_hits_total[5m])) / sum(rate(warden_cache_requests_total[5m]))",
          "legendFormat": "Overall Cache Hit Ratio",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(warden_cache_hits_total{tier=\"L1_LOCAL\"}[5m])) / sum(rate(warden_cache_requests_total[5m]))",
          "legendFormat": "L1 Local Hit Ratio",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(warden_cache_hits_total{tier=\"L2_REDIS\"}[5m])) / sum(rate(warden_cache_requests_total[5m]))",
          "legendFormat": "L2 Redis Hit Ratio",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Laya ModernBERT Inference Latency (p95 < 45ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(warden_laya_inference_duration_seconds_bucket[5m])) by (le, primitive)) * 1000",
          "legendFormat": "p95 {{primitive}} (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Presidio PII Redactions by Entity Type",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(warden_pii_redaction_hits_total[1h])) by (entity_type)",
